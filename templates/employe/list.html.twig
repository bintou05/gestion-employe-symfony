{% extends 'base.html.twig' %}

{% block title %}Liste des Employés{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Liste des Employés {% if departement %} du {{departement.name}} {% endif %}</h2>
        {%  if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_employe_add') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Nouvel Employé
            </a>
        {% endif %}
    </div>
    {% if idDept %}
                Employés du département
            {% else %}
                
            {% endif %}

    {# Filtre recherche #}
    <div class="card border-0 shadow mb-4">
    <div class="card-body">
        {{ form_start(formSearchEmp) }}
            <div class="row g-3 align-items-center">
                <!-- Champ numéro -->
                <div class="col-md-3">
                    {{ form_widget(formSearchEmp.numero, {'attr': {'class': 'form-control', 'placeholder': 'Rechercher par numéro'}}) }}
                </div>
                
                <!-- Checkbox Archived -->
                <div class="col-md-2">
                    <div class="form-check">
                        {{ form_widget(formSearchEmp.isArchived) }}
                    </div>
                </div>
                
                <!-- Sélecteur Département -->
                <div class="col-md-4">
                    {{ form_widget(formSearchEmp.departement, {'attr': {'class': 'form-select'}}) }}
                </div>
                
                <!-- Bouton Recherche -->
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100" type="submit">
                        <i class="fas fa-search me-2"></i>Rechercher
                    </button>
                </div>
            </div>
        {{ form_end(formSearchEmp) }}
    </div>
</div>


    {# Tableau des employés #}
    <div class="card border-0 shadow-sm">
        <div class="card-body">
        {% if employes|length > 0 %}
        {% include 'components/messageFlash.html.twig' %}
                                
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">photo</th>
                            <th scope="col">Numero</th>
                            <th scope="col">Nom</th>
                            <th scope="col">Téléphone</th>
                            <th scope="col">Date d'embauche</th>
                            <th scope="col">Département</th>
                            <th scope="col">Statut</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for employe in employes %}
                        <tr>
                            <td>
                            <img src="{{employe.photo}}"alt="photo de {{employe.nomComplet}}" class="rounded-circle"with="50"height="50">
                            
                            </td>
                            <td>{{ employe.numero }}</td>
                            <td>{{ employe.nomComplet }}</td>
                            <td>{{ employe.telephone }}</td>
                            <td>{{ employe.embaucheAt|date('Y-m-d')}}</td>
                            <td> {{ employe.departementName ?? 'N/A' }} </td>

                            <td> {% include 'components/status.html.twig' with{
                                    active: employe.isArchived, color:'success'
                            } %}</td>
                            <td>
                                <div class="btn-group">
                                    <a href="#" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i> Voir
                                    </a>
                                    <a href="#" class="btn btn-sm btn-outline-secondary">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a href="#" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash-alt"></i> Archiver
                                    </a>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% include 'components/pagination.html.twig' with {
                    nbrePage: nbrePage,
                    pageEncours: pageEncours,
                    pathName: 'app_employe_list'
                } %}
        {% else %}
            {% if departement %}
                <tr>
                   <td colspan="7" class="text-center">Aucun employé trouvé dans le département {{ departement.name }}.</td>  
                </tr>
            {% else %}
                <tr>
                   <td colspan="7" class="text-center">Le Departement n'existe pas.</td>  
                </tr>
            {% endif %}

        {% endif %}
        
          
        </div>
    </div>
</div>
{% endblock %}