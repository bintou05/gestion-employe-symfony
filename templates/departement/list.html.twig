    {% extends 'base.html.twig' %}
    {% block title %}Liste des departements {% endblock %}
    {% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Liste des departements</h2>
        </div>

        <!-- Filtre recherche -->
        <div class="card border-0 shadow mb-4">
            <div class="card-body">
            {% include 'components/messageFlash.html.twig' %}
            {{ form_start(formDept,{'attr':{
                'data-turbo':'false'
            }}) }}
            
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="fas fa-search"></i>
                            </span>
                            {{ form_widget(formDept.name)}}
                        </div>
                        <div class="text-danger">
                            {{ form_errors(formDept.name) }}
                        </div>
                    </div>
                    <div class="col-md-2">
                    {{ form_widget(formDept.btnSaveDept, {label:'Enregistrer', attr: {'class': 'btn btn-outline-primary w-100'}}) }}
                    </div>
                </div>
            {{ form_end(formDept) }}
            </div>
        </div>

        <!-- Tableau des employés -->
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Nom </th>
                                <th scope="col">nombre d'employe</th>
                                <th scope="col">Date de création</th>
                                <th scope="col"> status </th>
                                <th scope="col">Actions</th>
                                
                            </tr>
                        </thead>
                        <tbody>
                         {% for departement in departements %}
                            <tr>
                                <td>{{ departement.id }}</td>
                                <td>{{ departement.name }}</td>
                                <td><span class="badge bg-primary rounded-pill">
                                    {{ departement.nbreEmploye }} employé(s)
                                </span></td>
                                <td>{{ departement.creatAt ? departement.creatAt|date('Y-m-d') : '' }}</td>
                                <td> {% include 'components/status.html.twig' with{
                                    active: departement.isArchived, color:'info'
                                } %}</td>
                             
                                <td>
                                    <div class="btn-group">
                                        <a href="{{ path('app_employe_list', {'idDept': departement.id}) }}" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i> Voir
                                        </a>
                                        <a href="#" class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <a href="#" class="btn btn-sm btn-outline-danger 
                                        {% if departement.isArchived %}disabled{% endif %}">
                                            <i class="fas fa-trash-alt"></i> Archive
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="6" class="text-center">Aucun département trouvé.</td>  
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% include 'components/pagination.html.twig' with {
                    nbrePage: nbrePage,
                    pageEncours: pageEncours,
                    pathName: 'app_departement_list'
                } %}
            </div>
        </div>
    </div>
{% endblock %}

